# Postgres. docker compose sets this for you; set it yourself when running npm run dev.
DATABASE_URL=postgres://reddit_leads:reddit_leads@localhost:5433/reddit_leads

# The public origin of this instance. Must match the OAuth redirect you registered.
APP_URL=http://localhost:3000

# 32 random bytes, base64. Encrypts stored AnyAPI refresh tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# true on a self-hosted instance: removes every tier limit.
SELF_HOSTED=true

# true on exactly one process: runs the every-minute job tick.
RUN_SCHEDULER=true

# Clerk (https://clerk.com). Create an application and paste its two keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# AnyAPI (https://getanyapi.com).
ANYAPI_BASE_URL=https://api.getanyapi.com
# Printed by: npm run anyapi:register
ANYAPI_OAUTH_CLIENT_ID=
# The key this instance falls back to when a user has not connected a wallet.
ANYAPI_HOUSE_API_KEY=

# TypeSafe (https://typesafe.ai) judges every title, post and comment the scan reads.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest

# OpenRouter pays for the product profile, drafting and clustering.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta/muse-spark-1.3-contributor

# Email digests. The From address, plus one carrier. When more than one is set the first wins.
# Must be an address on a domain the carrier has verified.
ALERTS_FROM_EMAIL=
# Azure Communication Services: the Communication resource's connection string.
AZURE_EMAIL_CONNECTION_STRING=
# Any SMTP server, e.g. smtps://user:pass@smtp.example.com:465
SMTP_URL=
# Resend (https://resend.com).
RESEND_API_KEY=

# Add to Slack. Optional: without these, Slack takes a pasted webhook URL.
# A Slack app with Incoming Webhooks on and <APP_URL>/connect/slack/callback as a redirect URL.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Daily ceilings on what the house key spends, in USD. Ignored per wallet-funded user.
HOUSE_DATA_CAP_USD_PER_DAY=25
HOUSE_LLM_CAP_USD_PER_DAY=10
